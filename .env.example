MONGO_URI=your-mongodb-uri-here
JWT_SECRET=some-long-random-string-here
PORT=4000

# SMTP settings for sending OTP emails (optional but recommended)
# If these are not set, OTP codes will be logged to the server console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="FeedbackIntel <your-email@gmail.com>"

# Code required when registering as Management (admin)
ADMIN_REGISTER_SECRET=management2026